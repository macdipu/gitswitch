# `gitswitch setup` for the README (docs/images/setup.gif). Run by gifs.sh.
Output setup.gif
Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms

Hide
Type "exec su - alex" Enter
Sleep 1s
Type "export PS1='$ '; git config --global user.name 'Alex Rivera'; gitswitch set ssh-path /usr/local/bin/fakessh; mkdir -p ~/code; clear" Enter
Sleep 1s
Show

Type "gitswitch setup" Sleep 400ms Enter
Sleep 2.5s
Type "work" Sleep 300ms Enter
Sleep 400ms Enter
Sleep 400ms Enter
Sleep 300ms Type "alex@acme.dev" Sleep 300ms Enter
Sleep 400ms Enter
Sleep 1.2s Enter
Sleep 600ms Enter
Sleep 2.5s
Type "n" Enter
Sleep 1.5s Enter
Sleep 1.5s
Type "y" Enter
Sleep 500ms
Type "personal" Sleep 300ms Enter
Sleep 400ms Enter
Sleep 400ms Enter
Sleep 300ms Type "alex.rivera@gmail.com" Sleep 300ms Enter
Sleep 400ms Enter
Sleep 1.2s Enter
Sleep 600ms Enter
Sleep 2.5s
Type "n" Enter
Sleep 1.5s Enter
Sleep 1.5s
Type "n" Enter
Sleep 2.5s
Enter
Sleep 1.5s
Type "y" Enter
Sleep 600ms Enter
Sleep 600ms Type "work" Enter
Sleep 600ms Type "acme-corp" Enter
Sleep 1s
Type "n" Enter
Sleep 1.2s
Type "~/code" Sleep 300ms Enter
Sleep 5s
